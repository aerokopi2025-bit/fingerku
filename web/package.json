{
  "name": "fingerku-web-ui",
  "version": "1.0.0",
  "description": "Tailwind CSS v4 Web UI for Fingerku ZKTeco Biometric Management",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./static/style.css --minify && mkdir -p ../cmd/fingerku-web/static && cp -r ./static/* ../cmd/fingerku-web/static/",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./static/style.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
